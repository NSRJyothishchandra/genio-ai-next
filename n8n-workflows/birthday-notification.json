{
  "name": "Projecta HR — Birthday Notification (AI)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 24, "triggerAtHour": 9 }]
        }
      },
      "id": "node-schedule-birthday",
      "name": "Every Morning 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.PROJECTA_APP_URL}}/api/birthday",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "options": {}
      },
      "id": "node-get-birthdays",
      "name": "Get Today's Birthdays",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-birthday-count",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-birthdays",
      "name": "Has Birthdays Today?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Today's birthdays at Projecta HR:\n{{ $json.today.map(e => `- ${e.name} (${e.position})`).join('\\n') }}\n\nWrite a warm, professional birthday announcement for our HR dashboard. Keep it under 3 sentences, celebratory and inclusive.",
        "options": {}
      },
      "id": "node-ai-birthday-message",
      "name": "AI: Generate Birthday Message",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [960, 200]
    },
    {
      "parameters": {
        "model": "claude-sonnet-4-5",
        "options": { "maxTokens": 300, "temperature": 0.8 }
      },
      "id": "node-claude-birthday",
      "name": "Claude AI",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [960, 400],
      "credentials": { "anthropicApi": { "id": "anthropic-creds", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.PROJECTA_APP_URL}}/api/birthday",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "sendAll", "value": true }]
        },
        "options": {}
      },
      "id": "node-send-birthday-emails",
      "name": "Send Birthday Emails",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.PROJECTA_APP_URL}}/api/n8n/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-webhook-secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "event", "value": "birthday_check" },
            { "name": "data", "value": "={\"message\": \"Birthday emails sent\", \"count\": {{ $('Get Today\\'s Birthdays').item.json.count }}}" }
          ]
        },
        "options": {}
      },
      "id": "node-notify-app",
      "name": "Notify HR App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [{ "id": "no-birthday", "name": "message", "value": "No birthdays today", "type": "string" }]
        },
        "options": {}
      },
      "id": "node-no-birthdays",
      "name": "No Birthdays Today",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [960, 420]
    }
  ],
  "connections": {
    "Every Morning 9 AM": { "main": [[{ "node": "Get Today's Birthdays", "type": "main", "index": 0 }]] },
    "Get Today's Birthdays": { "main": [[{ "node": "Has Birthdays Today?", "type": "main", "index": 0 }]] },
    "Has Birthdays Today?": {
      "main": [
        [{ "node": "AI: Generate Birthday Message", "type": "main", "index": 0 }],
        [{ "node": "No Birthdays Today", "type": "main", "index": 0 }]
      ]
    },
    "AI: Generate Birthday Message": { "main": [[{ "node": "Send Birthday Emails", "type": "main", "index": 0 }]] },
    "Claude AI": { "ai_languageModel": [[{ "node": "AI: Generate Birthday Message", "type": "ai_languageModel", "index": 0 }]] },
    "Send Birthday Emails": { "main": [[{ "node": "Notify HR App", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "Asia/Kolkata" },
  "id": "projecta-birthday-workflow",
  "meta": { "templateCredsSetupCompleted": false },
  "tags": [{ "name": "Projecta HR" }, { "name": "Birthday" }, { "name": "AI" }]
}
